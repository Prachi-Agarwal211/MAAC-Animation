# =============================================================================
# ADVERTISING & CONVERSION TRACKING (Meta Ads + Google Ads)
# =============================================================================
# These are REQUIRED if you want to run paid ads effectively.

# --- Meta (Facebook/Instagram) Ads ---
# Pixel ID (found in Meta Events Manager → Data Sources → Pixels)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id_here

# Meta Conversions API Access Token (Server-side events - much more reliable)
# Get it from: Meta Events Manager → Settings → Conversions API → Generate Access Token
# This token must be kept SECRET (never expose on client).
META_ACCESS_TOKEN=your_long_meta_capi_access_token_here

# --- Google Ads + Analytics ---
# Google Tag Manager Container ID (RECOMMENDED - one script for GA4 + Google Ads + everything)
# Create at: https://tagmanager.google.com → Create Account → Web container
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID (if not using GTM)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads Conversion ID (for direct gtag conversion tracking)
# Found in Google Ads → Tools → Conversions → Your conversion action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=xxxxxxxxxxxxxxxxxxxx   # The label part after /

# Google Search Console Verification
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-verification-code

# Microsoft Clarity (Optional - session recordings & heatmaps)
NEXT_PUBLIC_CLARITY_ID=xxxxxx

# =============================================================================
# SERVER-ONLY SECRETS (never use NEXT_PUBLIC_ prefix)
# =============================================================================
# Google Service Account (for Sheets API)
GOOGLE_PRIVATE_KEY=your_google_private_key_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email_here
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here

# Resend (for transactional emails)
RESEND_API_KEY=your_resend_api_key_here

# =============================================================================
# IMPORTANT SETUP STEPS (read this!)
# =============================================================================
# 1. Meta Ads:
#    - Add your domain in Meta Business Manager → Domains
#    - Verify domain (recommended: add meta tag or DNS record)
#    - In Events Manager, confirm your "Lead" events are receiving data
#    - For CAPI: paste the META_ACCESS_TOKEN above (get from Events Manager)
#
# 2. Google Ads:
#    - Best: Use Google Tag Manager (add GTM container ID above)
#    - In GTM create tags for:
#        • Google Analytics 4 (configuration)
#        • Google Ads (conversion linker + your conversion actions)
#    - Link GA4 + Google Ads accounts
#    - For Enhanced Conversions (recommended): enable in Google Ads + send user data
#
# 3. After changing env vars → restart dev server (npm run dev)
# =============================================================================
