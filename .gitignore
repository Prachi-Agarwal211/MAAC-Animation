.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data exports
/MAAC WEBSITE DATA-20260402T150538Z-1-001

# videos - ignore large video files but allow optimized web videos
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.wmv
*.flv

# Exceptions for optimized web videos (must be under 15MB each)
!public/intro.webm
!public/intro.mp4
!public/hero-video-compressed.mp4
!public/hero-video.webm
!public/event-compressed.mp4
!public/student-work/*-compressed.mp4
nul

# dev scripts (local utilities, not part of app)
/scripts
/scratch

# IDE/tool configs
.kilo/
